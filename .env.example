# Copia a .env y completa. Nunca subas .env al repo.
OPENROUTER_API_KEY=
# Extracción: texto (PDF con capa de texto, .eml, chat) con modelos baratos; imágenes con los fuertes
EXTRACTOR_MODELO_A=google/gemini-2.5-flash-lite
EXTRACTOR_MODELO_B=openai/gpt-4.1-nano
EXTRACTOR_MODELO_A_IMAGEN=google/gemini-2.5-flash
EXTRACTOR_MODELO_B_IMAGEN=openai/gpt-4.1-mini

# JEV (TypeSafe). auto = typesafe si hay llave, si no llm (shim con el mismo contrato)
JEV_BACKEND=auto
TYPESAFE_API_KEY=
# o, sin llave de TypeSafe, JEV por Vercel AI Gateway (usa https://ai-gateway.vercel.sh/typesafe y typesafe-ai/jev)
AI_GATEWAY_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai   (por defecto según la llave)
# TYPESAFE_MODEL=jev-latest                  (por defecto según la llave)
JEV_LLM_MODELO=google/gemini-2.5-flash

# Un PIN por rol. Mínimo 6 caracteres. Vacío o "cambiar-esto" = ese rol deshabilitado (sin ninguno, solo lectura).
# Aprobador: todo (subir, demo, aprobar/rechazar, editar mandato y reglas, anclar).
APROBADOR_PIN=
# Operador: subir facturas, procesar el set de demostración y anclar.
OPERADOR_PIN=
# Jurado: subir facturas y procesar el set, con cupo diario (hora de Bogotá). No aprueba ni edita.
JURADO_PIN=
JURADO_CUPO=60

# Base de datos: Postgres si hay URL (Railway la inyecta); vacío = SQLite en DATA_DIR
DATABASE_URL=

# Llave Ed25519 en base64 (32 bytes) que firma la cabeza del registro sellado.
# Vacío = se crea DATA_DIR/sello.key. Generar: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SELLO_LLAVE=
# Cada cuántos minutos se ancla la cabeza en Bitcoin con OpenTimestamps si cambió (0 = nunca)
ANCLA_MINUTOS=10

# Carpeta de datos (mandato.json, facturas, SQLite de respaldo)
DATA_DIR=./data
# Fecha fija para evaluaciones reproducibles (vacío = hoy)
MANDATO_HOY=
